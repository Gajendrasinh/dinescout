# ── DineScout environment configuration ─────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# ── API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:8100,http://localhost:4200

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dinescout:dinescout@localhost:5432/dinescout?schema=public

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# ── AI provider ──────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to run DineScout AI in local-heuristic fallback
# mode (tools stay real, generation is templated, no external calls).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=15000

# ── Map provider ─────────────────────────────────────────────────────────
# Leave MAP_API_KEY empty to run the static/list map fallback provider.
MAP_PROVIDER=google
MAP_API_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ── Mobile / Admin (build-time, non-secret) ─────────────────────────────
API_BASE_URL=http://localhost:3000/api/v1
