// DineScout database schema.
// Run `npm run prisma:migrate --workspace apps/api` to create/apply migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum RestaurantStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PriceRange {
  BUDGET // $
  MODERATE // $$
  UPSCALE // $$$
  FINE_DINING // $$$$
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

enum ReviewReportReason {
  SPAM
  OFFENSIVE
  FAKE
  IRRELEVANT
  OTHER
}

enum ReviewReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NotificationType {
  REVIEW_PUBLISHED
  REVIEW_FLAGGED
  REVIEW_REPLIED
  FAVORITE_REMINDER
  SYSTEM
}

// ── Users & auth ────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  displayName    String   @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  role           UserRole @default(USER)
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  preferences      UserPreferences?
  favorites        Favorite[]
  reviews          Review[]
  reviewReports    ReviewReport[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  searchHistory    SearchHistory[]
  aiConversations  AiConversation[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  family    String // rotation family id — reused-token detection revokes the whole family
  revokedAt DateTime? @map("revoked_at")
  replacedByTokenHash String? @map("replaced_by_token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId])
  @@index([family])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId])
}

model UserPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  favoriteCuisines    String[] @map("favorite_cuisines") // CuisineSlug values
  dietaryPreferences  String[] @map("dietary_preferences") // DietaryTag values
  pricePreference     PriceRange? @map("price_preference")
  preferredDistanceKm Float    @default(5) @map("preferred_distance_km")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ── Cuisines & dietary options ─────────────────────────────────────────

model Cuisine {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  emoji String

  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

model DietaryOption {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  emoji String

  restaurants RestaurantDietaryOption[]

  @@map("dietary_options")
}

// ── Restaurants ─────────────────────────────────────────────────────────

model Restaurant {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  address     String
  lat         Float
  lng         Float
  phone       String?
  website     String?
  priceRange  PriceRange       @map("price_range")
  status      RestaurantStatus @default(PUBLISHED)
  ratingAvg   Float            @default(0) @map("rating_avg")
  ratingCount Int              @default(0) @map("rating_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  cuisines        RestaurantCuisine[]
  dietaryOptions  RestaurantDietaryOption[]
  hours           RestaurantHour[]
  photos          RestaurantPhoto[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  reviews         Review[]
  favorites       Favorite[]

  @@map("restaurants")
  @@index([status])
  @@index([lat, lng])
  @@index([ratingAvg])
}

model RestaurantCuisine {
  restaurantId String @map("restaurant_id")
  cuisineId    String @map("cuisine_id")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
  @@index([cuisineId])
}

model RestaurantDietaryOption {
  restaurantId    String @map("restaurant_id")
  dietaryOptionId String @map("dietary_option_id")

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dietaryOption DietaryOption @relation(fields: [dietaryOptionId], references: [id], onDelete: Cascade)

  @@id([restaurantId, dietaryOptionId])
  @@map("restaurant_dietary_options")
  @@index([dietaryOptionId])
}

model RestaurantHour {
  id           String  @id @default(cuid())
  restaurantId String  @map("restaurant_id")
  dayOfWeek    Int     @map("day_of_week") // 0 = Sunday .. 6 = Saturday
  opensAt      String  @map("opens_at") // "09:00"
  closesAt     String  @map("closes_at") // "22:00"
  isClosed     Boolean @default(false) @map("is_closed")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_hours")
  @@unique([restaurantId, dayOfWeek])
}

model RestaurantPhoto {
  id           String  @id @default(cuid())
  restaurantId String  @map("restaurant_id")
  url          String
  alt          String?
  isPrimary    Boolean @default(false) @map("is_primary")
  sortOrder    Int     @default(0) @map("sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_photos")
  @@index([restaurantId])
}

// ── Menu ────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String @id @default(cuid())
  restaurantId String @map("restaurant_id")
  name         String
  sortOrder    Int    @default(0) @map("sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@map("menu_categories")
  @@unique([restaurantId, name])
}

model MenuItem {
  id            String   @id @default(cuid())
  restaurantId  String   @map("restaurant_id")
  categoryId    String   @map("category_id")
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("SGD")
  imageUrl      String?  @map("image_url")
  isVegetarian  Boolean  @default(false) @map("is_vegetarian")
  isVegan       Boolean  @default(false) @map("is_vegan")
  isSpicy       Boolean  @default(false) @map("is_spicy")
  isPopular     Boolean  @default(false) @map("is_popular")
  isAvailable   Boolean  @default(true) @map("is_available")
  allergens     String[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("menu_items")
  @@index([restaurantId])
  @@index([categoryId])
  @@index([name])
}

// ── Reviews ─────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  restaurantId   String       @map("restaurant_id")
  userId         String       @map("user_id")
  rating         Int
  title          String
  comment        String
  status         ReviewStatus @default(PENDING)
  helpfulCount   Int          @default(0) @map("helpful_count")
  editedByAuthor Boolean      @default(false) @map("edited_by_author")
  moderationNote String?      @map("moderation_note")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos     ReviewPhoto[]
  reports    ReviewReport[]

  @@map("reviews")
  // A user may only leave one active review per restaurant.
  @@unique([restaurantId, userId])
  @@index([restaurantId, status])
  @@index([userId])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String @map("review_id")
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
  @@index([reviewId])
}

model ReviewReport {
  id         String              @id @default(cuid())
  reviewId   String              @map("review_id")
  reporterId String              @map("reporter_id")
  reason     ReviewReportReason
  note       String?
  status     ReviewReportStatus  @default(OPEN)
  createdAt  DateTime            @default(now()) @map("created_at")
  resolvedAt DateTime?           @map("resolved_at")

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("review_reports")
  @@unique([reviewId, reporterId])
  @@index([status])
}

// ── Favorites ───────────────────────────────────────────────────────────

model Favorite {
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@map("favorites")
  @@index([restaurantId])
}

// ── Search & AI ─────────────────────────────────────────────────────────

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  query     String
  filters   Json?
  resultCount Int    @default(0) @map("result_count")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
  @@index([userId])
  @@index([createdAt])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  title     String   @default("New conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
  @@index([userId])
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String
  toolCalls      Json?         @map("tool_calls") // record of which whitelisted tools were invoked
  richContent    Json?         @map("rich_content") // restaurant/menu cards for the client to render
  degraded       Boolean       @default(false) // true if generated by the local fallback provider
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
  @@index([conversationId])
}

// ── Notifications & audit ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String // e.g. "review.status_changed", "restaurant.published"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([createdAt])
}
