{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/jest-e2e.setup.ts"],
  "globalSetup": "<rootDir>/test/jest-e2e.global-setup.ts",
  "testTimeout": 20000
}
