# Copy to prod.tfvars (gitignored) and fill in before `terraform apply`.
environment = "prod"
aws_region  = "us-east-1"

db_instance_class = "db.t4g.small"
db_multi_az       = true

api_desired_count = 2
api_image_tag     = "latest" # pin to a commit SHA tag in real CI, not "latest"

# secret_arns = {
#   JWT_ACCESS_SECRET  = "arn:aws:secretsmanager:us-east-1:123456789012:secret:dinescout/jwt-access-xxxxxx"
#   JWT_REFRESH_SECRET = "arn:aws:secretsmanager:us-east-1:123456789012:secret:dinescout/jwt-refresh-xxxxxx"
#   AI_API_KEY         = "arn:aws:secretsmanager:us-east-1:123456789012:secret:dinescout/ai-key-xxxxxx"
#   MAP_API_KEY        = "arn:aws:secretsmanager:us-east-1:123456789012:secret:dinescout/map-key-xxxxxx"
# }

tags = {
  Owner = "dinescout-team"
}
